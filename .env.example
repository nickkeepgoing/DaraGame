# ---------------------------------------------------------------
# Supabase  (Dashboard -> Project Settings -> API)
# ---------------------------------------------------------------
# Safe to expose: the anon key is designed for client-side use and
# is protected by Row Level Security. Copy this file to .env.local.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional build stamp, written into runs.client_version
VITE_APP_VERSION=0.1.0

# ---------------------------------------------------------------
# NEVER put SUPABASE_SERVICE_ROLE_KEY in this project.
# Vite inlines every VITE_* variable into the shipped JS bundle,
# and the service_role key bypasses ALL Row Level Security.
# Keep it in the Supabase dashboard / CI secrets only.
# ---------------------------------------------------------------
